# Copy to .env and fill in. NEVER commit .env.

# ── LLM provider ────────────────────────────────────────────────────
# mock       = offline, labelled "not AI", no key (default for Render demo)
# groq       = Groq free plan            (GROQ_API_KEY)        18+
# gemini     = Google Gemini free tier   (GEMINI_API_KEY)      18+, prompts may be used by Google
# openrouter = OpenRouter ":free" models (OPENROUTER_API_KEY)  18+
# ollama     = local model, e.g. Qwen    (no key)
# openai     = OpenAI, PAID              (OPENAI_API_KEY)
# The engine never switches provider or model automatically. See docs/FREE_LLM_PROVIDERS.md.
LLM_PROVIDER=mock
# Optional: overrides the provider-specific *_MODEL below
LLM_MODEL=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENROUTER_API_KEY=
# Must end with ":free" and be in the allowlist (or in LLM_ALLOWED_MODELS)
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_APP_URL=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:4b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: OpenAI-compatible endpoint / proxy for the openai provider
OPENAI_BASE_URL=

# Free-tier protection (empty = provider defaults, see docs/FREE_LLM_PROVIDERS.md)
LLM_REQUESTS_PER_MINUTE=
LLM_REQUESTS_PER_DAY=
# Replace the built-in free-model allowlist (comma-separated). OpenRouter still requires ":free".
LLM_ALLOWED_MODELS=
# Retry automatically only if the provider asks to wait at most this long (seconds)
LLM_MAX_RETRY_AFTER_SECONDS=20
# auto = response_format json_object, falls back to prompt-only JSON if the model rejects it
LLM_JSON_MODE=auto
# reasoning_effort for thinking models: empty = provider default, "off" = do not send
LLM_REASONING_EFFORT=
# Optional: leave empty for the model default
OPENAI_TEMPERATURE=
# Legacy switch, used only when LLM_PROVIDER is empty
LLM_MODE=openai

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_SECONDS=0.5
REQUEST_TIMEOUT_SECONDS=120
MAX_INPUT_TOKENS=12000
# Thinking models (Gemini 3.x, gpt-oss, qwen3) spend output tokens on reasoning: 4000 is safer
MAX_OUTPUT_TOKENS=1500
MAX_MESSAGE_CHARS=8000

# ── Cost control ────────────────────────────────────────────────────
# Prices per 1M tokens, used ONLY for the paid openai provider (free providers are always 0).
# Leave empty -> estimated_cost is null (never guessed).
PRICE_INPUT_PER_1M_TOKENS=
PRICE_OUTPUT_PER_1M_TOKENS=
PRICE_CURRENCY=USD
# Daily limits in PRICE_CURRENCY (empty = unlimited). Enforced only when prices are set.
DAILY_SPEND_LIMIT=5
COMPANY_DAILY_SPEND_LIMIT=1

# ── Demo limits ─────────────────────────────────────────────────────
DEMO_MODE=true
DAILY_RUN_LIMIT_PER_USER=10
QUOTA_TIMEZONE=Asia/Almaty
RATE_LIMIT_PER_MINUTE=30
AUTH_FAILURES_PER_MINUTE=20

# ── Files ───────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
MAX_PDF_PAGES=200
# PDF/DOCX parsing runs in a separate process with these limits
EXTRACTION_TIMEOUT_SECONDS=30
EXTRACTION_MEMORY_MB=1024
# Private directory, never served over HTTP
STORAGE_DIR=./data/uploads

# ── Database ────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/ai_engine.db
# DATABASE_URL=postgresql+psycopg://ai_engine:CHANGE_ME@localhost:5432/ai_engine
AUTO_MIGRATE=true

# ── Security ────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins (no wildcard)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Shared secret for JWTs issued by the marketplace backend (optional)
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_AUDIENCE=
JWT_ISSUER=
# Optional local demo key created at startup. Generate:
#   python -c "import secrets; print('aie_' + secrets.token_urlsafe(32))"
DEMO_API_KEY=
DEMO_COMPANY_NAME=Demo Company (fictional)

# ── App ─────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
DEFAULT_LANGUAGE=ru
ENABLE_DEMO_UI=true
ENABLE_DOCS=true
AGENT_MODULES=app.agents.marketing,app.agents.support,app.agents.hr
