# Copy to .env and fill in. NEVER commit .env.

# ── LLM ─────────────────────────────────────────────────────────────
# openai = real OpenAI API (needs OPENAI_API_KEY); mock = labelled offline mode for architecture tests
LLM_MODE=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: OpenAI-compatible endpoint / proxy
OPENAI_BASE_URL=
# Optional: leave empty for the model default (some reasoning models reject custom temperature)
OPENAI_TEMPERATURE=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_SECONDS=0.5
REQUEST_TIMEOUT_SECONDS=120
MAX_INPUT_TOKENS=12000
MAX_OUTPUT_TOKENS=1500
MAX_MESSAGE_CHARS=8000

# ── Cost control ────────────────────────────────────────────────────
# Prices per 1M tokens for OPENAI_MODEL. Take them from the provider's current price list.
# Leave empty -> estimated_cost is null (never guessed).
PRICE_INPUT_PER_1M_TOKENS=
PRICE_OUTPUT_PER_1M_TOKENS=
PRICE_CURRENCY=USD
# Daily limits in PRICE_CURRENCY (empty = unlimited). Enforced only when prices are set.
DAILY_SPEND_LIMIT=5
COMPANY_DAILY_SPEND_LIMIT=1

# ── Demo limits ─────────────────────────────────────────────────────
DEMO_MODE=true
DAILY_RUN_LIMIT_PER_USER=10
QUOTA_TIMEZONE=Asia/Almaty
RATE_LIMIT_PER_MINUTE=30
AUTH_FAILURES_PER_MINUTE=20

# ── Files ───────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
MAX_PDF_PAGES=200
# PDF/DOCX parsing runs in a separate process with these limits
EXTRACTION_TIMEOUT_SECONDS=30
EXTRACTION_MEMORY_MB=1024
# Private directory, never served over HTTP
STORAGE_DIR=./data/uploads

# ── Database ────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/ai_engine.db
# DATABASE_URL=postgresql+psycopg://ai_engine:CHANGE_ME@localhost:5432/ai_engine
AUTO_MIGRATE=true

# ── Security ────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins (no wildcard)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Shared secret for JWTs issued by the marketplace backend (optional)
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_AUDIENCE=
JWT_ISSUER=
# Optional local demo key created at startup. Generate:
#   python -c "import secrets; print('aie_' + secrets.token_urlsafe(32))"
DEMO_API_KEY=
DEMO_COMPANY_NAME=Demo Company (fictional)

# ── App ─────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
DEFAULT_LANGUAGE=ru
ENABLE_DEMO_UI=true
ENABLE_DOCS=true
AGENT_MODULES=app.agents.marketing,app.agents.support,app.agents.hr
